from minigrad.tensor._types import NestedNumSequence
from minigrad.tensor._types import NumArray
from minigrad.tensor.ops import Op

class Tensor:
    def __init__(
        self,
        data: NestedNumSequence | NumArray,
        op: Op | None = None,
        name: str | None = None,
        requires_grad: bool = False,
    ) -> None: ...
    @property
    def data(self) -> NumArray: ...
    @property
    def op(self) -> Op | None: ...
    @property
    def name(self) -> str: ...
    @property
    def requires_grad(self) -> bool: ...
    def __add__(self, other: NestedNumSequence | NumArray | Tensor) -> Tensor: ...
    def __radd__(self, other: NestedNumSequence | NumArray | Tensor) -> Tensor: ...
    def __mul__(self, other: NestedNumSequence | NumArray | Tensor) -> Tensor: ...
    def __rmul__(self, other: NestedNumSequence | NumArray | Tensor) -> Tensor: ...
    def __matmul__(self, other: NestedNumSequence | NumArray | Tensor) -> Tensor: ...
    def __rmatmul__(self, other: NestedNumSequence | NumArray | Tensor) -> Tensor: ...
    def __neg__(self) -> Tensor: ...
    def __pow__(self, exponent: int | float) -> Tensor: ...
    def __sub__(self, other: NestedNumSequence | NumArray | Tensor) -> Tensor: ...
