from minigrad.scalar.ops import Op

class Scalar:
    def __init__(
        self,
        data: int | float,
        op: Op | None = None,
        name: str | None = None,
        requires_grad: bool = False,
    ) -> None: ...
    def __repr__(self) -> str: ...
    @property
    def data(self) -> float: ...
    @data.setter
    def data(self, value: float) -> None: ...
    @property
    def op(self) -> Op | None: ...
    @op.setter
    def op(self, op_instance: Op | None) -> None: ...
    @property
    def name(self) -> str: ...
    @name.setter
    def name(self, value: str) -> None: ...
    @property
    def grad(self) -> float | None: ...
    @grad.setter
    def grad(self, value: float | None) -> None: ...
    @property
    def requires_grad(self) -> bool: ...
    @requires_grad.setter
    def requires_grad(self, value: bool) -> None: ...
    def backward(self) -> None: ...
    def __iadd__(self, other: float) -> Scalar: ...
    def __add__(self, other: Scalar | int | float) -> Scalar: ...
    def __radd__(self, other: Scalar | int | float) -> Scalar: ...
    def __mul__(self, other: Scalar | int | float) -> Scalar: ...
    def __rmul__(self, other: Scalar | int | float) -> Scalar: ...
    def __neg__(self) -> Scalar: ...
    def __sub__(self, other: Scalar | int | float) -> Scalar: ...
    def __rsub__(self, other: Scalar | int | float) -> Scalar: ...
    def __pow__(self, other: int | float) -> Scalar: ...
